<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground: a white "DP" monogram (DailyPlanner) centred in
    the 72dp safe zone of the 108dp viewport. Drawn with thick rounded strokes
    so it reads clearly at small launcher sizes.

    "D" = vertical stem + a right-hand bowl (semicircle).
    "P" = vertical stem + an upper bowl (semicircle), stem continuing below.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <!-- "D" -->
        <!-- Vertical stem -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M34,36 L34,72" />
        <!-- Right-hand bowl: semicircle bulging to the right -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M34,36 A18,18 0 0 1 34,72" />

        <!-- "P" -->
        <!-- Vertical stem (runs slightly lower than the D) -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M62,36 L62,76" />
        <!-- Upper bowl: semicircle bulging to the right -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M62,36 A13,13 0 0 1 62,62" />
    </group>
</vector>

