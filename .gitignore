# =============================================================================
# .gitignore — DailyPlanner
#
# Rule of thumb: commit only SOURCE + CONFIG. Never commit anything that is
# downloaded (node_modules, Gradle wrapper distribution, SDKs), generated by a
# build (dist, build, release, Android build dirs), machine-specific, or secret.
# =============================================================================

# ---- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# ---- Secrets & signing keys (NEVER commit these) ----------------------------
# Windows code-signing / Android keystores and their passwords.
*.jks
*.keystore
*.p12
keystore.properties
android/keystore.properties
# Machine-specific SDK path written by Android Studio / Gradle.
android/local.properties

# ---- Node / Electron --------------------------------------------------------
# Downloaded third-party packages (restored with `npm install`).
node_modules/

# Compiled TypeScript/CSS bundles produced by `npm run build`.
dist/

# Application icons generated by `scripts/make-icon.js` / `npm run icon`.
build/icon.ico
build/icon.png
build/icon-preview.png

# electron-builder output: installers + unpacked Electron runtime.
release/

# Logs & scratch output.
*.log
ua-out.txt

# ---- Android / Gradle -------------------------------------------------------
# Gradle caches, daemon state and generated build output.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
# NOTE: android/gradle/wrapper/** MUST stay tracked — it is the build launcher.
# Do NOT ignore android/gradle.

# Some Gradle/Android Studio folders emitted anywhere.
.gradle/
captures/
*.hprof

# ---- Keep this file itself --------------------------------------------------
!.gitignore
